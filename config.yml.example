# Sample config for train.py, based on training-run-2.35.
#
# Replace X.YY, the export name and NUM_CLASSES for your run, or let
# prepare_training.sh (computervision repo) do it.
#
# Training guide, step 6:
# https://github.com/inaturalist/computervision/blob/main/doc/train_cv_model_guide.md

#### EXPERIMENT PARAMETERS

WANDB_PROJECT         : "iNat CV"
WANDB_LOG_FREQ        : 100

# set by prepare_training.sh
TENSORBOARD_LOG_DIR   : "/disk/mnt/data/experiments/training-run-X.YY/log_dir"
CHECKPOINT_DIR        : "/disk/mnt/data/experiments/training-run-X.YY/checkpoints/ckpt"
FINAL_SAVE_PATH       : "/disk/mnt/data/experiments/training-run-X.YY/final_model/saved_model.h5"
BACKUP_DIR            : "/disk/mnt/data/experiments/training-run-X.YY/backup"


#### DATASET PARAMETERS

# set by prepare_training.sh
TRAINING_DATA         : "/disk/mnt/data/exports/vision-export-YYYYMMDDHHMMSS-aka-X.YY/train_cleaned.parquet"
VAL_DATA              : "/disk/mnt/data/exports/vision-export-YYYYMMDDHHMMSS-aka-X.YY/val_cleaned.parquet"
# the test split is not built by the pipeline -- see the note in the guide
TEST_DATA             : "/disk/mnt/data/exports/vision-export-YYYYMMDDHHMMSS-aka-X.YY/test_cleaned.parquet"
# number of taxa, counted from train_cleaned.parquet once the export is cleaned
NUM_CLASSES           : 0
LABEL_COLUMN_NAME     : "leaf_class_id"

#### TRAINING PARAMETERS

# weights the training starts from
CHECKPOINT            : "/disk/mnt/data/experiments/exporttest_full_iconic_spatial_20220405/big-model-baseline/checkpoints/ckpt"
TRAIN_FULL_MODEL      : False
VALIDATION_PASS_SIZE  : 50_000
SHUFFLE_BUFFER_SIZE   : 200_000

# training policy - only use mixed precision=true if you
# have a recent NVIDIA GPU that supports CUDA 7.0 or later
TRAIN_MIXED_PRECISION : False

MULTIGPU : True

# size of batch, per gpu
BATCH_SIZE            : 256

# number of training epochs
NUM_EPOCHS            : 20

# initial learning rate for the model
INITIAL_LEARNING_RATE : 0.05
LR_DECAY_FACTOR       : 0.94
EPOCHS_PER_LR_DECAY   : 4

# either "imagenet" or path to pretrained weights
PRETRAINED_MODEL      : "imagenet"
ACTIVATION            : Null

DO_LABEL_SMOOTH       : True
LABEL_SMOOTH_MODE     : "flat"
LABEL_SMOOTH_PCT      : 0.1

#### MODEL PARAMETERS

# neural network architecture
MODEL_NAME            : "xception"

# size of input
IMAGE_SIZE            : [299,299]

# optiimzer
OPTIMIZER_NAME        : "rmsprop"
RMSPROP_RHO           : 0.9
RMSPROP_MOMENTUM      : 0.9
RMSPROP_EPSILON       : 1.0
